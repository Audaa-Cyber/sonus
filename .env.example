# Server-side AI provider configuration. Never prefix API keys with NEXT_PUBLIC_.
# Preferred settings: any OpenAI-compatible Chat Completions provider with JSON mode.
SONUS_AI_API_KEY=
# API root only, without /chat/completions. Clean APIs: https://cleanapis.com/v1
SONUS_AI_BASE_URL=
SONUS_AI_MODEL=

# Backward-compatible aliases; used when the matching SONUS_AI_* value is blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables WalletConnect-based wallet connections in RainbowKit.
# Get a project ID from https://cloud.walletconnect.com/
# Injected browser wallets such as MetaMask can be tested without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
