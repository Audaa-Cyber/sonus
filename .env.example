# Server-only AI provider configuration for Sonus.
# Use an OpenAI-compatible Chat Completions endpoint.
# Keep all keys on the server; never prefix them with NEXT_PUBLIC_.
SONUS_AI_API_KEY=
# API root only, without /chat/completions. Examples:
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
SONUS_AI_BASE_URL=https://api.openai.com/v1
SONUS_AI_MODEL=gpt-4.1-mini

# Backward-compatible aliases (used only when the SONUS_AI_* value above is blank).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
