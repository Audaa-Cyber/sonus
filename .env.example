# Optional for local fallback mode; required for AI-powered chat.
# Create a key in your OpenAI developer account and keep it server-side only.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables WalletConnect-based wallet connections in RainbowKit.
# Get a project ID from https://cloud.walletconnect.com/
# Injected browser wallets such as MetaMask can be tested without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
