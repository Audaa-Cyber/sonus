# Server-side AI provider configuration. Never prefix API keys with NEXT_PUBLIC_.
# Preferred settings: any OpenAI-compatible Chat Completions provider with JSON mode.
SONUS_AI_API_KEY=
# API root only, without /chat/completions. Clean APIs: https://cleanapis.com/v1
SONUS_AI_BASE_URL=
SONUS_AI_MODEL=

# Backward-compatible aliases; used when the matching SONUS_AI_* value is blank.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables WalletConnect-based wallet connections in RainbowKit.
# Get a project ID from https://cloud.walletconnect.com/
# Injected browser wallets such as MetaMask can be tested without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional dedicated OpenAI Realtime API key for low-latency WebRTC voice.
# This must be an OpenAI API key with Realtime API access, not a CleanAPIs proxy key.
# If unset, Sonus falls back to browser speech recognition + browser speech synthesis.
OPENAI_REALTIME_API_KEY=
# Explicit opt-in; leave false until production access controls are in place.
OPENAI_REALTIME_ENABLED=false
# Optional. Defaults to gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
